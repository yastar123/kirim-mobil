PORT=5001
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/KIRIMMOBIL
KIRIMMOBIL_ADMIN_EMAIL=admin@example.com
KIRIMMOBIL_ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional persistent storage path when PRIVATE_OBJECT_DIR is not configured.
KIRIMMOBIL_UPLOAD_DIR=uploads