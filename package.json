{
  "name": "kirimmobil-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "dev:5000": "PORT=5000 tsx server.ts",
    "start": "tsx scripts/start-production.ts",
    "start:5000": "PORT=5000 tsx server.ts",
    "build": "npm run build --workspace=@workspace/kirimmobil",
    "build:all": "npm run typecheck:libs && npm run --workspaces --if-present build",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs",
    "lint": "npm run typecheck",
    "db:push": "npm run push --workspace=@workspace/db"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2"
  }
}
